// These reads never repair a document. In particular, retain the raw native
// stream rather than the editor's persisted/export normalization: a final-mark
// format change is evidence, just as a changed field instruction would be.
struct FindRecoveryNativeTrace {
 fs::path root;HWND edit=nullptr;notes_undo::Document original,temporaryOriginal;
 bool sawModeBaseline=false,sawModeVerified=false,sawFinalRawVerification=false;
 std::function<void(const char *,HWND,bool)> previous;unsigned sequence=0;
 FindRecoveryNativeTrace(HWND target,const fs::path &directory):root(directory),edit(target){
  if(!target)return;notes_undo::CaptureDocument(edit,original);Put(root/L"original.rtf",original.rtf);
  previous=std::move(notes_undo::diagnosticSink);
  notes_undo::diagnosticSink=[this](const char *stage,HWND target,bool result){Record(stage,target,result);};
  Record("trace.original",edit,true);
 }
 ~FindRecoveryNativeTrace(){if(edit)notes_undo::diagnosticSink=std::move(previous);}
