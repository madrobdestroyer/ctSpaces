  if(target!=edit)return;notes_undo::Document actual;const bool captured=notes_undo::CaptureDocument(edit,actual);
  if(!strcmp(stage,"discard.mode-original")){sawModeBaseline=result&&captured&&actual.length==original.length&&actual.links==original.links;temporaryOriginal=actual;}
  if(!strcmp(stage,"discard.marker-original"))sawModeVerified=result&&captured&&actual.length==temporaryOriginal.length&&actual.rtf==temporaryOriginal.rtf&&actual.links==temporaryOriginal.links;
  if(!strcmp(stage,"discard.final-original"))sawFinalRawVerification=result&&captured&&actual.length==original.length&&actual.rtf==original.rtf&&actual.links==original.links;
  CHARRANGE selected{};POINT scroll{};CHARFORMAT2W pending{sizeof(pending)};
  SendMessageW(edit,EM_EXGETSEL,0,reinterpret_cast<LPARAM>(&selected));SendMessageW(edit,EM_GETSCROLLPOS,0,reinterpret_cast<LPARAM>(&scroll));SendMessageW(edit,EM_GETCHARFORMAT,SCF_SELECTION,reinterpret_cast<LPARAM>(&pending));
  const auto serial=++sequence;const auto name=std::to_wstring(serial)+L"-"+std::wstring(stage,stage+strlen(stage));
  Put(root/(name+L".rtf"),actual.rtf);std::string runs;for(const auto &run:actual.links)runs+=std::to_string(run.first)+" "+std::to_string(run.last)+" cookie="+std::to_string(run.cookie)+" effects="+std::to_string(run.effects)+"\n";Put(root/(name+L"-runs.txt"),runs);
  const auto common=(std::min)(original.rtf.size(),actual.rtf.size());size_t difference=0;while(difference<common&&original.rtf[difference]==actual.rtf[difference])++difference;
  std::string report="stage="+std::string(stage)+" result="+std::to_string(result)+" captured="+std::to_string(captured)+" length="+std::to_string(actual.length)+" originalLength="+std::to_string(original.length)+" rawBytes="+std::to_string(actual.rtf.size())+" originalRawBytes="+std::to_string(original.rtf.size())+" firstDifference="+std::to_string(difference)+" rawEqual="+std::to_string(actual.rtf==original.rtf)+" linkRunsEqual="+std::to_string(actual.links==original.links)+" canUndo="+std::to_string(SendMessageW(edit,EM_CANUNDO,0,0))+" canRedo="+std::to_string(SendMessageW(edit,EM_CANREDO,0,0))+" undoName="+std::to_string(SendMessageW(edit,EM_GETUNDONAME,0,0))+" redoName="+std::to_string(SendMessageW(edit,EM_GETREDONAME,0,0))+" selection="+std::to_string(selected.cpMin)+","+std::to_string(selected.cpMax)+" scroll="+std::to_string(scroll.x)+","+std::to_string(scroll.y)+" pendingMask="+std::to_string(pending.dwMask)+" pendingEffects="+std::to_string(pending.dwEffects)+" pendingCookie="+std::to_string(pending.dwCookie)+" autoFlags="+std::to_string(SendMessageW(edit,EM_GETAUTOURLDETECT,0,0))+" nativeLimit="+std::to_string(SendMessageW(edit,EM_GETLIMITTEXT,0,0));
