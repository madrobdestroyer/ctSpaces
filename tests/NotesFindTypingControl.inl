 Command(owner,IDC_NOTES_UNDO);const bool older=exact(original,originalRtf);Command(owner,IDC_NOTES_REDO);Check(older&&exact(result.beforeText,result.beforeRtf),"The no-cleanup typing control independently proves its older Undo and Redo");Save(owner);
 const LONG length=notes_find::Length(edit);if(atLimit)SendMessageW(edit,EM_EXLIMITTEXT,0,length);const auto limit=SendMessageW(edit,EM_GETLIMITTEXT,0,0);Select(edit,12,12);SendMessageW(edit,EM_GETCHARFORMAT,SCF_SELECTION,reinterpret_cast<LPARAM>(&result.input));POINT desired{0,120};SendMessageW(edit,EM_SETSCROLLPOS,0,reinterpret_cast<LPARAM>(&desired));FindProbeFirstFont(edit);result.inputFont=FindProbeFont(edit,{12,12});
 if(contextProbe){FindProbeFont(edit,{11,12});FindProbeFont(edit,{12,13});NotesNativeLinkAddress(edit,state,{11,12});NotesNativeLinkAddress(edit,state,{12,13});}
