 Check(exact(result.beforeText,result.beforeRtf),"Read-only observations leave the independent typing control's document exact");Command(owner,IDC_NOTES_REDO);Check(exact(result.beforeText,result.beforeRtf)&&NotesNativeLinkAddress(edit,state,{0,length})==url,"An unavailable Redo leaves the independent typing control exact");
 if(limit<=length)SendMessageW(edit,EM_EXLIMITTEXT,0,length+1);Type(owner,L"Z");SendMessageW(edit,EM_STOPGROUPTYPING,0,0);result.typedText=NotesWindowText(edit);StreamClientNotesOut(edit,result.typedRtf);Select(edit,12,13);SendMessageW(edit,EM_GETCHARFORMAT,SCF_SELECTION,reinterpret_cast<LPARAM>(&result.glyph));result.glyphFont=FindProbeFont(edit,{12,13});result.address=NotesNativeLinkAddress(edit,state,{12,13});
 Command(owner,IDC_NOTES_UNDO);const bool glyphUndo=exact(result.beforeText,result.beforeRtf);Command(owner,IDC_NOTES_UNDO);const bool olderUndo=exact(original,originalRtf);Command(owner,IDC_NOTES_REDO);const bool olderRedo=exact(result.beforeText,result.beforeRtf);Command(owner,IDC_NOTES_REDO);const bool glyphRedo=exact(result.typedText,result.typedRtf)&&NotesNativeLinkAddress(edit,state,{12,13})==result.address;Command(owner,IDC_NOTES_UNDO);result.history=glyphUndo&&olderUndo&&olderRedo&&glyphRedo&&exact(result.beforeText,result.beforeRtf);SendMessageW(edit,EM_EXLIMITTEXT,0,limit);
