// Independent ordinary typing oracle: no failed operation and no cleanup API.
struct FindTypingControl {
 std::wstring beforeText,typedText,address;fs::path root;std::string durable;
 std::string beforeRtf,typedRtf;
 CHARFORMAT2W input{sizeof(input)},observed{sizeof(observed)},glyph{sizeof(glyph)};
 FindProbeNativeFont inputFont{},glyphFont{};
 bool history=false;
};
