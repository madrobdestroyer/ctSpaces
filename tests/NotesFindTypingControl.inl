 FindTypingControl result;const std::wstring url=L"https://example.test/edge-first?client=private";
 const auto owner=FindFixture(atLimit?L"All-linked typing control limit":L"All-linked typing control normal",L"");auto &state=State(owner);const auto edit=Edit(owner);
