 Select(edit,6,6);CHARFORMAT2W typing{sizeof(typing)};typing.dwMask=CFM_ITALIC|CFM_SIZE|CFM_BACKCOLOR;typing.dwEffects=CFE_ITALIC;typing.yHeight=280;typing.crBackColor=RGB(64,96,128);SendMessageW(edit,EM_SETCHARFORMAT,SCF_SELECTION,reinterpret_cast<LPARAM>(&typing));Save(owner);SendMessageW(edit,EM_EMPTYUNDOBUFFER,0,0);
 const auto original=NotesWindowText(edit);std::string originalRtf;StreamClientNotesOut(edit,originalRtf);Type(owner,L" prior");SendMessageW(edit,EM_STOPGROUPTYPING,0,0);Save(owner);result.beforeText=NotesWindowText(edit);StreamClientNotesOut(edit,result.beforeRtf);
