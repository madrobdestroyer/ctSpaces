IDD_NOTES_HELP DIALOGEX 0, 0, 460, 218
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "How client notes work"
FONT 10, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT "A notebook for this client",1530,12,10,436,14
    LTEXT "Notes stay with this client and save locally. Each tab is a separate note.",-1,12,28,436,18
    LTEXT "1. Start writing",-1,12,48,210,13
    LTEXT "Click + to start. Double-click a tab to rename it. X closes the tab; your saved note stays in All notes.",-1,12,65,210,28
    LTEXT "2. Saving is automatic",-1,238,48,210,13
    LTEXT "Edits save after a pause, when switching tabs, and on close. A failed save is reported in the title.",-1,238,65,210,28
    LTEXT "3. Find and reopen",-1,12,90,210,13
    LTEXT "All notes finds saved notes by title, ticket number or text. Preview a result, then Open.",-1,12,107,210,28
    LTEXT "4. Tickets are optional",-1,238,90,210,13
    LTEXT "Details links a note to a ticket. All note URLs use your default browser. Status is local; tickets do not sync.",IDC_NOTES_HELP_TICKETS,238,107,210,28
    LTEXT "5. Reusable templates",-1,12,132,210,13
    LTEXT "Templates lets you write, edit and save starters directly. Use template creates a separate client note.",IDC_NOTES_HELP_TEMPLATES,12,149,210,28
    LTEXT "6. Archive and Trash",-1,238,132,210,13
    LTEXT "Archive hides kept notes. Trash keeps deleted notes until you restore or permanently delete them. There is no expiry.",IDC_NOTES_HELP_TRASH,238,149,210,28
    PUSHBUTTON "Templates",IDC_NOTES_TEMPLATES,12,190,76,18
    PUSHBUTTON "All notes",IDC_NOTES_LIBRARY,96,190,72,18
    PUSHBUTTON "Trash",IDC_NOTES_TRASH,176,190,56,18
    PUSHBUTTON "Walkthrough",IDC_NOTES_WALKTHROUGH,240,190,104,18
    DEFPUSHBUTTON "Got it",IDOK,376,190,72,18
END

