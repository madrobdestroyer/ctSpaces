IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About ctSpaces"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_CTSPACES,IDC_STATIC,14,14,21,20
    LTEXT           CTSPACES_ABOUT_TEXT,IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright InfinityResearchAndDevelopment(c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_THEME DIALOGEX 0, 0, 200, 80
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Color"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
END

IDD_INACTIVE_CLIENTS DIALOGEX 0, 0, 390, 260
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Clean Up Inactive Clients"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT "",IDC_INACTIVE_HEADING,12,10,366,30,SS_NOPREFIX
    LISTBOX IDC_INACTIVE_LIST,12,44,366,128,LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_MULTIPLESEL | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Select All",IDC_INACTIVE_ALL,12,176,65,14
    PUSHBUTTON "Clear Selection",IDC_INACTIVE_NONE,83,176,86,14
    LTEXT "Permanently removes every browser profile, logins, cookies, bookmarks, history, extensions, sessions, client icons, and managed desktop shortcuts. This cannot be undone.",IDC_STATIC,12,194,366,28,SS_NOPREFIX
    CONTROL "I understand that all selected clients will be permanently deleted.",IDC_INACTIVE_ACK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,225,366,12
    PUSHBUTTON "Delete Selected (0)",IDOK,192,242,112,14
    DEFPUSHBUTTON "Cancel",IDCANCEL,310,242,68,14
END

IDD_CLEANUP_RESULT DIALOGEX 0, 0, 390, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Cleanup Complete"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    EDITTEXT IDC_CLEANUP_RESULT_TEXT,12,12,366,157,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    DEFPUSHBUTTON "OK",IDOK,310,178,68,14
END

IDD_GUIDED_WALKTHROUGH DIALOGEX 0, 0, 570, 365
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "ctSpaces Guided Walkthrough"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Topics",IDC_GUIDE_TOPICS_LABEL,12,10,132,10,SS_NOPREFIX
    LISTBOX         IDC_GUIDE_TOPICS,12,24,150,294,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_GUIDE_TITLE,176,12,382,18,SS_NOPREFIX
    LTEXT           "",IDC_GUIDE_LOCATION,176,34,382,22,SS_NOPREFIX
    EDITTEXT        IDC_GUIDE_BODY,176,60,382,258,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_GUIDE_COUNT,12,330,180,14,SS_NOPREFIX
    PUSHBUTTON      "Back",IDC_GUIDE_BACK,306,329,58,18
    PUSHBUTTON      "Quick tour",IDC_GUIDE_QUICK_TOUR,240,329,60,18
    DEFPUSHBUTTON   "Next",IDOK,370,329,58,18
    PUSHBUTTON      "Skip",IDCANCEL,434,329,64,18
END

IDD_QUICK_TOUR DIALOGEX 0, 0, 258, 142
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ctSpaces Quick Tour"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_QUICK_TOUR_TITLE,12,10,234,18,SS_NOPREFIX
    LTEXT           "",IDC_QUICK_TOUR_BODY,12,32,234,64,SS_NOPREFIX
    CONTROL         "",IDC_QUICK_TOUR_DEMO,"Static",SS_OWNERDRAW,12,98,234,10
    LTEXT           "",IDC_QUICK_TOUR_COUNT,12,112,64,14,SS_NOPREFIX
    PUSHBUTTON      "Back",IDC_QUICK_TOUR_BACK,82,108,48,20
    DEFPUSHBUTTON   "Next",IDOK,134,108,48,20
    PUSHBUTTON      "Skip",IDCANCEL,186,108,60,20
END


